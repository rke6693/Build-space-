# ---- Core ----
NODE_ENV=development
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-32-byte-base64

# ---- Database (Neon / Postgres) ----
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ---- Email (Resend) ----
RESEND_API_KEY=re_xxx
EMAIL_FROM="Space Runner <auth@example.com>"

# ---- OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx

# ---- Rate limit (Upstash) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Anti-cheat HMAC ----
# Generate with: openssl rand -base64 48
RUN_TOKEN_SECRET=replace-me-48-byte-base64

# ============================================================================
# Hermes voice relay (Apple Watch)
# ============================================================================
# Every var below is OPTIONAL. Device pairing works with none of them set; each
# channel simply reports SKIPPED until you configure it. Device secrets are
# sealed with a key derived from AUTH_SECRET, so there is no extra key to manage
# — but rotating AUTH_SECRET un-pairs every watch.

# ---- Channel: Telegram (recommended — instant, free, two-way) ----
# 1. Create a bot with @BotFather, copy the token.
# 2. Message the bot, then read your chat id from
#    https://api.telegram.org/bot<TOKEN>/getUpdates
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_CHAT_ID=
# Required only for replies to come BACK to the watch. Generate with:
#   openssl rand -hex 32
# then register the webhook:
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d url="https://<host>/api/hermes/telegram/webhook" \
#     -d secret_token="<this value>"
HERMES_TELEGRAM_WEBHOOK_SECRET=

# ---- Channel: generic webhook (point this straight at your Hermes agent) ----
# HTTPS only. Payloads are signed as sha256=HMAC(timestamp + "." + body).
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=

# ---- Channel: SMS via Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550001111
HERMES_SMS_TO=+15550002222

# ---- Channel: email (reuses RESEND_API_KEY / EMAIL_FROM above) ----
HERMES_EMAIL_TO=

# ---- Understanding ----
# With a key set, Claude cleans up dictation and resolves fuzzy times. Without
# one, the deterministic rule engine handles it alone — captures still work.
ANTHROPIC_API_KEY=
HERMES_LLM_MODEL=claude-opus-5
# Latency budget for the model pass; on timeout the rule engine's answer ships.
HERMES_LLM_TIMEOUT_MS=6000
# low keeps the confirmation haptic snappy; raise if you add richer routing.
HERMES_LLM_EFFORT=low
# Per-channel network budget.
HERMES_CHANNEL_TIMEOUT_MS=5000
